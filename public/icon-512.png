<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" width="512" height="512">
  <defs>
    <linearGradient id="grad512" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#009CDE;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#0077B5;stop-opacity:1" />
    </linearGradient>
  </defs>
  <rect width="512" height="512" rx="96" fill="url(#grad512)"/>
  <g transform="translate(256, 256)">
    <!-- Graduation cap -->
    <path d="M -120 -40 L 0 -80 L 120 -40 L 120 20 L 0 60 L -120 20 Z" fill="white" opacity="0.95"/>
    <ellipse cx="0" cy="20" rx="120" ry="30" fill="white" opacity="0.8"/>
    <!-- Lightning bolt (PLN symbol) -->
    <path d="M 80 -120 L 40 -40 L 80 -40 L 40 40 L 80 -20 L 40 -20 Z" fill="#FFD700" opacity="0.9"/>
  </g>
</svg>
