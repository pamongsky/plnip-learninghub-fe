# PRODUCTION Environment Configuration Template
# Copy this to .env.production and update with real production values

# ============================================
# API CONFIGURATION
# ============================================
# CRITICAL: Update to production backend URL
NEXT_PUBLIC_API_URL=https://api.portal.plnip.ac.id
NEXT_PUBLIC_BACKEND_URL=https://api.portal.plnip.ac.id

# ============================================
# PUSHER CONFIGURATION (WebSocket)
# ============================================
# MUST MATCH Laravel backend .env values
NEXT_PUBLIC_PUSHER_KEY=your_production_pusher_key
NEXT_PUBLIC_PUSHER_CLUSTER=ap1
NEXT_PUBLIC_PUSHER_HOST=
NEXT_PUBLIC_PUSHER_PORT=443
NEXT_PUBLIC_PUSHER_SCHEME=https

# ============================================
# APPLICATION CONFIGURATION
# ============================================
NEXT_PUBLIC_APP_NAME="PLNIP Portal"
NEXT_PUBLIC_APP_URL=https://portal.plnip.ac.id

# ============================================
# BUILD CONFIGURATION
# ============================================
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1

# ============================================
# ASSET OPTIMIZATION
# ============================================
# Enable image optimization
NEXT_PUBLIC_IMAGE_OPTIMIZATION=true

# CDN URL (if using CDN)
# NEXT_PUBLIC_CDN_URL=https://cdn.portal.plnip.ac.id

# ============================================
# FEATURES FLAGS
# ============================================
NEXT_PUBLIC_ENABLE_AI_CHAT=true
NEXT_PUBLIC_ENABLE_ANALYTICS=true

# ============================================
# MONITORING & ANALYTICS (Optional)
# ============================================
# Google Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Sentry for error tracking
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# ============================================
# SECURITY
# ============================================
# Content Security Policy headers should be configured in next.config.mjs

# ============================================
# NOTES FOR PRODUCTION BUILD
# ============================================
# 1. Run: npm run build
# 2. Test build: npm run start
# 3. Verify all environment variables are set
# 4. Enable CDN for static assets
# 5. Configure proper cache headers
# 6. Set up SSL/TLS certificates
# 7. Configure firewall rules
# 8. Set up monitoring and alerts
# 9. Test WebSocket connections work through firewall
# 10. Verify CORS settings allow production domain

# ============================================
# PM2 ECOSYSTEM CONFIGURATION
# ============================================
# See ecosystem.config.js for PM2 production deployment
